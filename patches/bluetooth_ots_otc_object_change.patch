+static void changed_indicate_work_handler(struct k_work *work)
+{
+	struct bt_gatt_ots_indicate *ind = CONTAINER_OF(work, struct bt_gatt_ots_indicate, work);
+	struct bt_ots *ots = CONTAINER_OF(ind, struct bt_ots, changed_ind);
+
+	bt_gatt_indicate(NULL, &ots->changed_ind.params);
+}
+
+static void ots_changed_cfg_changed(const struct bt_gatt_attr *attr, uint16_t value)
+{
+	struct bt_gatt_ots_indicate *changed_ind =
+		CONTAINER_OF((struct bt_gatt_ccc_managed_user_data *)attr->user_data,
+			     struct bt_gatt_ots_indicate, ccc);
+
+	LOG_DBG("Object Changed CCCD value: 0x%04X", value);
+
+	changed_ind->is_enabled = false;
+	if (value == BT_GATT_CCC_INDICATE) {
+		changed_ind->is_enabled = true;
+	}
+}
+
+static void ots_obj_changed_send(struct bt_ots *ots, uint64_t id, uint8_t flags)
+{
+	const struct bt_gatt_attr *changed_attr = NULL;
+
+	if (!IS_ENABLED(CONFIG_BT_OTS_OBJECT_CHANGED_SUPPORT)) {
+		return;
+	}
+
+	if (!ots->changed_ind.is_enabled) {
+		LOG_DBG("Object Changed indication not enabled by client");
+		return;
+	}
+
+	/* Find the Object Changed characteristic value attribute */
+	for (size_t i = 0; i < ots->service->attr_count; i++) {
+		const struct bt_gatt_attr *attr = &ots->service->attrs[i];
+
+		if (attr->uuid != NULL &&
+		    !bt_uuid_cmp(attr->uuid, BT_UUID_OTS_CHANGED)) {
+			changed_attr = attr;
+			break;
+		}
+	}
+
+	if (!changed_attr) {
+		LOG_ERR("Object Changed characteristic attribute not found");
+		return;
+	}
+
+	/* Build Object Changed value: Flags (1 byte) + Object ID (6 bytes) */
+	ots->changed_ind.res[0] = flags;
+	sys_put_le48(id, &ots->changed_ind.res[1]);
+
+	memset(&ots->changed_ind.params, 0, sizeof(ots->changed_ind.params));
+	memcpy(&ots->changed_ind.attr, changed_attr, sizeof(ots->changed_ind.attr));
+	ots->changed_ind.params.attr = &ots->changed_ind.attr;
+	ots->changed_ind.params.data = ots->changed_ind.res;
+	ots->changed_ind.params.len = BT_OTS_OBJ_ID_SIZE + 1;
+
+	k_work_submit(&ots->changed_ind.work);
+
+	char id_str[BT_OTS_OBJ_ID_STR_LEN];
+	bt_ots_obj_id_to_str(id, id_str, sizeof(id_str));
+	LOG_DBG("Object Changed indication sent: id=%s flags=0x%02x", id_str, flags);
+}
+
