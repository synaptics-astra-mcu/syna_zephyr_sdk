diff --git a/subsys/bluetooth/services/ots/ots_client.c b/subsys/bluetooth/services/ots/ots_client.c
index 3840b5ee34f..ddd090506a7 100644
--- a/subsys/bluetooth/services/ots/ots_client.c
+++ b/subsys/bluetooth/services/ots/ots_client.c
@@ -419,6 +419,31 @@ static void oacp_ind_handler(struct bt_conn *conn,
 	}
 }

+static void obj_changed_ind_handler(struct bt_conn *conn,
+				    struct bt_ots_client *otc_inst,
+				    const void *data, uint16_t length)
+{
+	struct net_buf_simple net_buf;
+
+	if (length < (sizeof(uint8_t) + BT_OTS_OBJ_ID_SIZE)) {
+		LOG_DBG("Invalid Object Changed indication length: %u", length);
+		return;
+	}
+
+	net_buf_simple_init_with_data(&net_buf, (void *)data, length);
+
+	uint8_t flags = net_buf_simple_pull_u8(&net_buf);
+	uint64_t obj_id = net_buf_simple_pull_le48(&net_buf);
+
+	char id_str[BT_OTS_OBJ_ID_STR_LEN];
+	bt_ots_obj_id_to_str(obj_id, id_str, sizeof(id_str));
+	LOG_INF("Object Changed indication: id=%s flags=0x%02x", id_str, flags);
+
+	if (otc_inst->cb->obj_changed) {
+		otc_inst->cb->obj_changed(otc_inst, conn, flags, obj_id);
+	}
+}
+
 uint8_t bt_ots_client_indicate_handler(struct bt_conn *conn,
 				       struct bt_gatt_subscribe_params *params,
 				       const void *data, uint16_t length)
@@ -448,6 +473,8 @@ uint8_t bt_ots_client_indicate_handler(struct bt_conn *conn,
 			olcp_ind_handler(conn, inst->otc_inst, data, length);
 		} else if (handle == inst->otc_inst->oacp_handle) {
 			oacp_ind_handler(conn, inst->otc_inst, data, length);
+		} else if (handle == inst->otc_inst->obj_changed_handle) {
+			obj_changed_ind_handler(conn, inst->otc_inst, data, length);
 		}
 	}
 	return BT_GATT_ITER_CONTINUE;
