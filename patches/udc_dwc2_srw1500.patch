diff --git a/drivers/usb/udc/udc_dwc2_vendor_quirks.h b/drivers/usb/udc/udc_dwc2_vendor_quirks.h
index 3a74d8b30eb..80d43756f03 100644
--- a/drivers/usb/udc/udc_dwc2_vendor_quirks.h
+++ b/drivers/usb/udc/udc_dwc2_vendor_quirks.h
@@ -774,2 +774,112 @@ DT_INST_FOREACH_STATUS_OKAY(QUIRK_SYNA_SR100_USB_DEFINE)
 
+#if DT_HAS_COMPAT_STATUS_OKAY(syna_srw1500_usb)
+
+#include <zephyr/drivers/clock_control.h>
+#include <zephyr/drivers/reset.h>
+#include <zephyr/sys/sys_io.h>
+#include <soc_regs.h>
+
+struct syna_srw1500_usb_resources {
+	struct usb_dwc2_reg *base;
+	mem_addr_t wrapper_ctrl1;
+	const struct device *clock_dev;
+	clock_control_subsys_t clock_id;
+	struct reset_dt_spec phy_reset;
+	struct reset_dt_spec core_ahb_reset;
+};
+
+static inline void srw1500_usb_delay(uint32_t count)
+{
+	while (count-- != 0U) {
+		__asm__ volatile("nop");
+	}
+}
+
+static inline int srw1500_usb_pre_enable(
+	const struct syna_srw1500_usb_resources *resources)
+{
+	int ret;
+
+	if (!device_is_ready(resources->clock_dev) ||
+	    !device_is_ready(resources->phy_reset.dev) ||
+	    !device_is_ready(resources->core_ahb_reset.dev)) {
+		return -ENODEV;
+	}
+
+	ret = clock_control_on(resources->clock_dev, resources->clock_id);
+	if (ret != 0) {
+		return ret;
+	}
+
+	sys_set_bits((mem_addr_t)&resources->base->dctl, USB_DWC2_DCTL_SFTDISCON);
+	k_busy_wait(250000);
+
+	ret = reset_line_assert_dt(&resources->phy_reset);
+	if (ret != 0) {
+		return ret;
+	}
+	srw1500_usb_delay(10000);
+
+	ret = reset_line_deassert_dt(&resources->phy_reset);
+	if (ret != 0) {
+		return ret;
+	}
+	srw1500_usb_delay(20000);
+
+	sys_write32(SRW1500_USB_DEVICE_CTRL1, resources->wrapper_ctrl1);
+	srw1500_usb_delay(50000);
+
+	ret = reset_line_assert_dt(&resources->core_ahb_reset);
+	if (ret != 0) {
+		return ret;
+	}
+	srw1500_usb_delay(10000);
+
+	ret = reset_line_deassert_dt(&resources->core_ahb_reset);
+	if (ret != 0) {
+		return ret;
+	}
+	srw1500_usb_delay(50000);
+
+	sys_set_bits((mem_addr_t)&resources->base->gotgctl,
+		     SRW1500_USB_BVALOEN | SRW1500_USB_BVALOVAL);
+
+	return 0;
+}
+
+static inline int srw1500_usb_init_caps(const struct device *dev)
+{
+	struct udc_data *data = dev->data;
+
+	data->caps.hs = true;
+
+	return 0;
+}
+
+#define QUIRK_SYNA_SRW1500_USB_DEFINE(n)                                      \
+	static const struct syna_srw1500_usb_resources resources_##n = {       \
+		.base = (struct usb_dwc2_reg *)                                  \
+			DT_INST_REG_ADDR_BY_NAME(n, core),                        \
+		.wrapper_ctrl1 = DT_INST_REG_ADDR_BY_NAME(n, wrapper_ctrl1),     \
+		.clock_dev = DEVICE_DT_GET(DT_INST_CLOCKS_CTLR(n)),             \
+		.clock_id =                                                     \
+			(clock_control_subsys_t)DT_INST_CLOCKS_CELL(n, clkid),   \
+		.phy_reset = RESET_DT_SPEC_INST_GET_BY_IDX(n, 0),                \
+		.core_ahb_reset = RESET_DT_SPEC_INST_GET_BY_IDX(n, 1),           \
+	};                                                                      \
+	                                                                        \
+	static int srw1500_usb_pre_enable_##n(const struct device *dev)         \
+	{                                                                       \
+		ARG_UNUSED(dev);                                                 \
+		return srw1500_usb_pre_enable(&resources_##n);                   \
+	}                                                                       \
+	                                                                        \
+	const struct dwc2_vendor_quirks dwc2_vendor_quirks_##n = {              \
+		.caps = srw1500_usb_init_caps,                                  \
+		.pre_enable = srw1500_usb_pre_enable_##n,                        \
+	};
+DT_INST_FOREACH_STATUS_OKAY(QUIRK_SYNA_SRW1500_USB_DEFINE)
+
+#endif /* DT_HAS_COMPAT_STATUS_OKAY(syna_srw1500_usb) */
+
