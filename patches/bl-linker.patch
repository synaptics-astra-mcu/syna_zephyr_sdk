diff --git a/include/zephyr/linker/iterable_sections.h b/include/zephyr/linker/iterable_sections.h
index 1aa3003d4a9..05ca567a7df 100644
--- a/include/zephyr/linker/iterable_sections.h
+++ b/include/zephyr/linker/iterable_sections.h
@@ -54,8 +54,14 @@
  * they are not being directly referenced. Use this when symbols
  * are indirectly referenced by iterating through the section.
  */
+#if defined(CONFIG_SOC_SERIES_SR1XX)
+#define SECTION_ALIGN ALIGN(32)
+#else
+#define SECTION_ALIGN
+#endif
+
 #define ITERABLE_SECTION_ROM(struct_type, subalign) \
-	SECTION_PROLOGUE(struct_type##_area, ,) \
+	SECTION_PROLOGUE(struct_type##_area, ,SECTION_ALIGN) \
 	{ \
 		Z_LINK_ITERABLE(struct_type); \
 	} GROUP_ROM_LINK_IN(RAMABLE_REGION, ROMABLE_REGION)
@@ -70,7 +76,7 @@
  * @see ITERABLE_SECTION_ROM()
  */
 #define ITERABLE_SECTION_ROM_NUMERIC(struct_type, subalign) \
-	SECTION_PROLOGUE(struct_type##_area, EMPTY,) \
+	SECTION_PROLOGUE(struct_type##_area, EMPTY, SECTION_ALIGN) \
 	{ \
 		Z_LINK_ITERABLE_NUMERIC(struct_type); \
 	} GROUP_ROM_LINK_IN(RAMABLE_REGION, ROMABLE_REGION)
@@ -108,7 +114,7 @@
  * are indirectly referenced by iterating through the section.
  */
 #define ITERABLE_SECTION_RAM(struct_type, subalign) \
-	SECTION_DATA_PROLOGUE(struct_type##_area, ,) \
+	SECTION_DATA_PROLOGUE(struct_type##_area, , SECTION_ALIGN) \
 	{ \
 		Z_LINK_ITERABLE(struct_type); \
