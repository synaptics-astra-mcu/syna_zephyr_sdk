diff --git a/boot/synaptics/Kconfig b/boot/synaptics/Kconfig
new file mode 100755
index 00000000..088146a0
--- /dev/null
+++ b/boot/synaptics/Kconfig
@@ -0,0 +1,30 @@
+# Copyright (c) 2026 Synaptics Incorporated
+#
+# SPDX-License-Identifier: Apache-2.0
+
+config BOOT_CUSTOM_SYNA_VALIDATION
+	bool "Synaptics secure co-processor validation support"
+	select MBOX
+	help
+	  Provides the mailbox command framing used by the Synaptics ECDSA
+	  backend. This does not enable MCUboot's whole-image access hooks.
+
+if BOOT_CUSTOM_SYNA_VALIDATION
+
+config BOOT_CUSTOM_SYNA_VALIDATION_TIMEOUT_MS
+	int "Timeout waiting for the co-processor's verify response [ms]"
+	default 2000
+
+config BOOT_SYNA_MAILBOX_SENDER_ID
+	hex "Synaprot M52 sender ID"
+	default 0x0
+
+config BOOT_SYNA_MAILBOX_SOC_CATEGORY
+	hex "Synaprot SOC command category"
+	default 0x0
+
+config BOOT_SYNA_MAILBOX_VERIFY_SIGNATURE_ID
+	hex "Synaprot verify-signature command ID"
+	default 0x0
+
+endif # BOOT_CUSTOM_SYNA_VALIDATION
diff --git a/boot/synaptics/syna_ecdsa.c b/boot/synaptics/syna_ecdsa.c
new file mode 100755
index 00000000..7ec8b3ba
--- /dev/null
+++ b/boot/synaptics/syna_ecdsa.c
@@ -0,0 +1,45 @@
+/*
+ * Copyright (c) 2026 Synaptics Incorporated
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "bootutil/crypto/ecdsa.h"
+#include "synaprot_service_srw1500.h"
+
+#define SYNA_VERIFY_OK      0
+#define SYNA_VERIFY_FAIL   -1
+
+void bootutil_ecdsa_init(bootutil_ecdsa_context *ctx)
+{
+	ctx->reserved = 0;
+}
+
+void bootutil_ecdsa_drop(bootutil_ecdsa_context *ctx)
+{
+	(void)ctx;
+}
+
+int bootutil_ecdsa_parse_public_key(bootutil_ecdsa_context *ctx,
+					    uint8_t **p, uint8_t *end)
+{
+	(void)ctx;
+
+	if (p == NULL || *p == NULL || end == NULL || *p > end) {
+		return -1;
+	}
+
+	/* The secure co-processor consumes the encoded key bytes directly. */
+	return 0;
+}
+
+int bootutil_ecdsa_verify(bootutil_ecdsa_context *ctx,
+                           uint8_t *pubkey, size_t pubkey_len,
+                           uint8_t *hash, size_t hash_len,
+                           uint8_t *sig, size_t sig_len)
+{
+	(void)ctx;
+
+	return syna_image_verify_signature(pubkey, pubkey_len, hash, hash_len,
+					   sig, sig_len) == SYNA_VERIFY_OK ? 0 : -1;
+}
