/ {
	vcc_emmc: regulator-vcc-emmc {
		compatible = "regulator-fixed";

		regulator-name = "EMMC Vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	vccq_emmc: regulator-vccq-emmc {
		compatible = "regulator-fixed";

		regulator-name = "EMMC VccQ";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	soc {
		emmc0: sdhc@d7a00000 {
			compatible = "snps,mshc", "syna,sl261x-emmc";
			reg = <0xd7a00000 0x1000>;
			interrupts = <170 0>;
			clock-frequency = <200000000>;
			pinctrl-0 = <>;
			pinctrl-names = "default";
			vmmc-supply = <&vcc_emmc>;
			vmmcq-supply = <&vccq_emmc>;
			max-bus-freq = <50000000>;
			no-dma;

			mmc {
				compatible = "zephyr,mmc-disk";
				disk-name = "EMMC";
				status = "okay";
			};
		};
	};
};
