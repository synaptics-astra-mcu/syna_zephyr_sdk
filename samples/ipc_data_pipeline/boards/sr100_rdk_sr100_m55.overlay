&{/chosen} {
    zephyr,console = &ns16550_uart1;
    zephyr,shell-uart = &ns16550_uart1;
};

/ {
};

&ns16550_uart1 {
    status = "okay";
    current-speed = <230400>;
    dlf = <2>;
};

&i2c0_ms_scl {
    bias-pull-up;
};

&i2c0_ms_sda {
    bias-pull-up;
};

&i2c1_ms_scl_b {
    bias-pull-up;
};

&i2c1_ms_sda_b {
    bias-pull-up;
};

&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_ms_scl &i2c0_ms_sda>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;

     i2c_controller_1: i2c_controller_1@0a {
        compatible = "generic-device";
        reg = <0x0a>;
        label = "TOUCH_CTRL_1";
    };
};

&i2c1 {
    status = "okay";
    /* i2cM1 on SWIRE bank: GPIO42=SCL, GPIO43=SDA */
    pinctrl-0 = <&i2c1_ms_scl_b &i2c1_ms_sda_b>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;

     i2c_controller_2: i2c_controller_2@42 {
        compatible = "generic-device";
        reg = <0x42>;
        label = "TOUCH_CTRL_2";
    };
};

&user_button {
    status = "okay";
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CDC ACM Uart 0";
    };

    cdc_acm_uart1: cdc_acm_uart1 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CDC ACM Uart 1";
    };

    hid_input_dev_0: hid_input_dev_0 {
        compatible = "zephyr,hid-device";
        label = "HID Input Devices";
        protocol-code = "none";
        in-report-size = <64>;
        in-polling-period-us = <1000>;
    };

    hid_custom_als_0: hid_custom_als_0 {
        compatible = "zephyr,hid-device";
        label = "HID Custom and Ambient Light";
        protocol-code = "none";
        in-report-size = <255>;
        in-polling-period-us = <1000>;
        out-report-size = <255>;
        out-polling-period-us = <1000>;
    };

    hid_hpd_0: hid_hpd_0 {
        compatible = "zephyr,hid-device";
        label = "HID Human Presence and Custom HPD";
        protocol-code = "none";
        in-report-size = <64>;
        in-polling-period-us = <1000>;
    };
};

&ipc0 {
    /* Must match the M4 build: 512 bytes MTU per direction. */
    shared-memory-size = <0x400>;
};
