+#ifdef CONFIG_DMA
+#define SPI_DW_DMA_DONE_TX BIT(0)
+#define SPI_DW_DMA_DONE_RX BIT(1)
+
+static __aligned(4) uint32_t spi_dw_dma_tx_dummy;
+static __aligned(4) uint32_t spi_dw_dma_rx_dummy;
+
+static bool spi_dw_dma_request_supported(const struct device *dev,
+					 struct spi_dw_data *spi,
+					 const struct spi_buf_set *tx_bufs,
+					 const struct spi_buf_set *rx_bufs)
+{
+	const struct spi_dw_config *info = dev->config;
+	const struct spi_buf *tx = (tx_bufs && tx_bufs->count) ? tx_bufs->buffers : NULL;
+	const struct spi_buf *rx = (rx_bufs && rx_bufs->count) ? rx_bufs->buffers : NULL;
+	size_t tx_len = tx ? tx->len : 0U;
+	size_t rx_len = rx ? rx->len : 0U;
+	size_t bytes = MAX(tx_len, rx_len);
+
+	if (!info->dma_dev) {
+		return false;
+	}
+
+	if ((tx_bufs && tx_bufs->count > 1U) || (rx_bufs && rx_bufs->count > 1U)) {
+		return false;
+	}
+
+	if (tx_len && rx_len && (tx_len != rx_len)) {
+		return false;
+	}
+
+	if (!bytes || (bytes < CONFIG_SPI_DW_DMA_THRESHOLD)) {
+		return false;
+	}
+
+	if ((bytes % spi->dfs) != 0U) {
+		return false;
+	}
+
+	return true;
+}
+
+static void spi_dw_dma_stop(const struct device *dev)
+{
+	const struct spi_dw_config *info = dev->config;
+
+	if (!info->dma_dev) {
+		return;
+	}
+
+	(void)dma_stop(info->dma_dev, info->dma_tx_channel);
+	(void)dma_stop(info->dma_dev, info->dma_rx_channel);
+}
+
+static void spi_dw_dma_callback(const struct device *dma_dev,
+				void *user_data,
+				uint32_t channel,
+				int status)
+{
+	const struct device *dev = user_data;
+	const struct spi_dw_config *info = dev->config;
+	struct spi_dw_data *spi = dev->data;
+	atomic_val_t done_bit = 0;
+
+	ARG_UNUSED(dma_dev);
+
+	if (channel == info->dma_tx_channel) {
+		done_bit = SPI_DW_DMA_DONE_TX;
+	} else if (channel == info->dma_rx_channel) {
+		done_bit = SPI_DW_DMA_DONE_RX;
+	} else {
+		return;
+	}
+
+	if ((status != 0) && (spi->dma_status == 0)) {
+		spi->dma_status = status;
+
+		if (atomic_cas(&spi->dma_complete, 0, 1)) {
+			spi_dw_dma_stop(dev);
+			completed(dev, status);
+		}
+
+		return;
+	}
+
+	(void)atomic_or(&spi->dma_done_mask, done_bit);
+
+	if (((atomic_get(&spi->dma_done_mask) & (SPI_DW_DMA_DONE_TX | SPI_DW_DMA_DONE_RX)) !=
+	     (SPI_DW_DMA_DONE_TX | SPI_DW_DMA_DONE_RX)) || !atomic_cas(&spi->dma_complete, 0, 1)) {
+		return;
+	}
+
+	spi_dw_dma_stop(dev);
+
+	if (spi->dma_status == 0) {
+		if (spi->dma_tx_frames) {
+			spi_context_update_tx(&spi->ctx, spi->dfs, spi->dma_tx_frames);
+		}
+
+		if (spi->dma_rx_frames) {
+			sys_cache_data_invd_range(spi->ctx.rx_buf, spi->dma_rx_frames * spi->dfs);
+			spi_context_update_rx(&spi->ctx, spi->dfs, spi->dma_rx_frames);
+		}
+	}
+
+	completed(dev, spi->dma_status);
+}
+
+static int spi_dw_dma_start(const struct device *dev,
+			    struct spi_dw_data *spi)
+{
+	const struct spi_dw_config *info = dev->config;
+	uint32_t tx_frames = spi->ctx.tx_len ? spi->ctx.tx_len : spi->ctx.rx_len;
+	uint32_t rx_frames = spi->ctx.rx_len ? spi->ctx.rx_len : spi->ctx.tx_len;
+	uint32_t tx_bytes = tx_frames * spi->dfs;
+	uint32_t rx_bytes = rx_frames * spi->dfs;
+	uint32_t source_address;
+	uint32_t dest_address;
+	uint32_t source_addr_adjust;
+	uint32_t dest_addr_adjust;
+	struct dma_config rx_dma_cfg = {
+		.source_data_size = spi->dfs,
+		.dest_data_size = spi->dfs,
+		.block_count = 1,
+		.channel_direction = PERIPHERAL_TO_MEMORY,
+		.source_burst_length = 1,
+		.dest_burst_length = 1,
+		.complete_callback_en = true,
+		.dma_callback = spi_dw_dma_callback,
+		.user_data = (void *)dev,
+	};
+	struct dma_config tx_dma_cfg = {
+		.source_data_size = spi->dfs,
+		.dest_data_size = spi->dfs,
+		.block_count = 1,
+		.channel_direction = MEMORY_TO_PERIPHERAL,
+		.source_burst_length = 1,
+		.dest_burst_length = 1,
+		.complete_callback_en = true,
+		.dma_callback = spi_dw_dma_callback,
+		.user_data = (void *)dev,
+	};
+	struct dma_block_config rx_block_cfg;
+	struct dma_block_config tx_block_cfg;
+	int ret;
+
+	if ((tx_frames == 0U) || (rx_frames == 0U) || (tx_bytes != rx_bytes)) {
+		return -EINVAL;
+	}
+
+	spi->dma_tx_frames = spi->ctx.tx_len ? tx_frames : 0U;
+	spi->dma_rx_frames = spi->ctx.rx_len ? rx_frames : 0U;
+	spi->dma_status = 0;
+	atomic_clear(&spi->dma_done_mask);
+	atomic_clear(&spi->dma_complete);
+
+	if (spi_context_rx_buf_on(&spi->ctx)) {
+		dest_address = (uint32_t)spi->ctx.rx_buf;
+		dest_addr_adjust = DMA_ADDR_ADJ_INCREMENT;
+	} else {
+		dest_address = (uint32_t)&spi_dw_dma_rx_dummy;
+		dest_addr_adjust = DMA_ADDR_ADJ_NO_CHANGE;
+	}
+
+	if (spi_context_tx_buf_on(&spi->ctx)) {
+		source_address = (uint32_t)spi->ctx.tx_buf;
+		source_addr_adjust = DMA_ADDR_ADJ_INCREMENT;
+		sys_cache_data_flush_range((void *)spi->ctx.tx_buf, tx_bytes);
+	} else {
+		source_address = (uint32_t)&spi_dw_dma_tx_dummy;
+		source_addr_adjust = DMA_ADDR_ADJ_NO_CHANGE;
+	}
+
+	(void)memset(&rx_block_cfg, 0, sizeof(rx_block_cfg));
+	rx_block_cfg.block_size = rx_bytes;
+	rx_block_cfg.source_address = (uint32_t)((mm_reg_t)DEVICE_MMIO_GET(dev) + DW_SPI_REG_DR);
+	rx_block_cfg.dest_address = dest_address;
+	rx_block_cfg.source_addr_adj = DMA_ADDR_ADJ_NO_CHANGE;
+	rx_block_cfg.dest_addr_adj = dest_addr_adjust;
+	rx_dma_cfg.head_block = &rx_block_cfg;
+
+	(void)memset(&tx_block_cfg, 0, sizeof(tx_block_cfg));
+	tx_block_cfg.block_size = tx_bytes;
+	tx_block_cfg.source_address = source_address;
+	tx_block_cfg.dest_address = (uint32_t)((mm_reg_t)DEVICE_MMIO_GET(dev) + DW_SPI_REG_DR);
+	tx_block_cfg.source_addr_adj = source_addr_adjust;
+	tx_block_cfg.dest_addr_adj = DMA_ADDR_ADJ_NO_CHANGE;
+	tx_dma_cfg.head_block = &tx_block_cfg;
+
+	ret = dma_config(info->dma_dev, info->dma_rx_channel, &rx_dma_cfg);
+	if (ret != 0) {
+		LOG_ERR("dma_config rx failed %d", ret);
+		return ret;
+	}
+
+	ret = dma_config(info->dma_dev, info->dma_tx_channel, &tx_dma_cfg);
+	if (ret != 0) {
+		LOG_ERR("dma_config tx failed %d", ret);
+		return ret;
+	}
+
+	write_dmardlr(dev, 0);
+	write_dmatdlr(dev, 0);
+	write_dmacr(dev, DW_SPI_DMACR_TX_RX);
+
+	ret = dma_start(info->dma_dev, info->dma_rx_channel);
+	if (ret != 0) {
+		LOG_ERR("dma_start rx failed %d", ret);
+		write_dmacr(dev, 0);
+		return ret;
+	}
+
+	ret = dma_start(info->dma_dev, info->dma_tx_channel);
+	if (ret != 0) {
+		LOG_ERR("dma_start tx failed %d", ret);
+		spi_dw_dma_stop(dev);
+		write_dmacr(dev, 0);
+		return ret;
+	}
+
+	return 0;
+}
