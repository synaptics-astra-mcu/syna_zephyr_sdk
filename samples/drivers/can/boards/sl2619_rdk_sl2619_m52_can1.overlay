/ {
	chosen {
		zephyr,canbus = &can1;
	};
};

&can1 {
	status = "okay";
	pinctrl-0 = <&sm_can1_tx &sm_can1_rxd>;
	pinctrl-names = "default";
	bitrate = <500000>;
	bitrate-data = <2000000>;
	sample-point = <800>;
	sample-point-data = <800>;
};
