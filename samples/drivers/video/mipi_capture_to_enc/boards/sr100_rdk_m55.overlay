/*
 * SR100 RDK overlay for the integrated MIPI capture + JPEG encoder sample.
 *
 * Reserves non-cached memory for the MIPI capture DMA target and JPEG encoder
 * working area.
 */

#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		video_capture_mem: video-capture-memory@33f6f000 {
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0x33f6f000 0x200000>; /* 1920x1080 RAW8 frame buffer (0x1FA400 bytes). */
			zephyr,memory-region = "VIDEO_CAPTURE_MEM";
			zephyr,memory-attr = <DT_MEM_ARM_MPU_RAM_NOCACHE>;
		};

		jpeg_encoder_mem: jpeg-encoder-memory@b4900000 {
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0xB4900000 0x9D800>; /* Reserved for encoder raw input and JPEG output buffers. */
			zephyr,memory-region = "JPEG_ENCODER_MEM";
			zephyr,memory-attr = <DT_MEM_ARM_MPU_RAM_NOCACHE>;
		};
	};

	enc0: jpeg-enc-video {
		compatible = "syna,enc-video";
		status = "okay";
		interrupt-parent = <&nvic>;

		interrupts = <102 0>, <103 0>, <109 0>;
		interrupt-names = "frame-done", "fmin1-stored", "status";

		mode = <1>; /* Memory-input mode */

		/* JPEG encoder working memory (raw input + JPEG output). */
		memory-region = <&jpeg_encoder_mem>;

		/*
		 * Encoder memory layout (mode=1):
		 * - [0x0000..0x3fff] reserved/unused
		 * - [frame-raw-offset .. frame-raw-offset + 0x7e900) raw input (960x540 RAW8)
		 * - JPEG output region placed after raw input (driver-managed)
		 *
		 * Keep the JPEG output region beyond the end of the raw input region.
		 */
		frame-raw-offset = <0x4000>;
		/* Size hint: must accommodate the largest expected JPEG output frame. */
		max-jpeg-size = <0x1af00>;
	};
};

&video_syna0 {
	/* DMA target memory used by the MIPI capture driver. */
	memory-region = <&video_capture_mem>;
};

&ov02c10 {
	data-lanes = <1>;
};

&sram0 {
	/*
	 * Use SRAM for zephyr,flash and zephyr,code-partition to avoid ITCM overflow.
	 * See `README.rst` for memory-layout details.
	 */
	reg = <0x33ea0000 0x00040000>;
	ranges = <0x0 0x33ea0000 0x00040000>;
};

/ {
	data_sram: memory@33ee0000 {
		compatible = "mmio-sram";
		reg = <0x33ee0000 0x0008f000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x33ee0000 0x0008f000>;
	};

	chosen {
		zephyr,sram = &data_sram;
		zephyr,flash = &sram0;
		zephyr,code-partition = &sram0;
	};
};

&xspi {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		jpeg_store: partition@800000 {
			label = "jpeg_store";
			reg = <0x800000 0x800000>;
		};
	};
};
