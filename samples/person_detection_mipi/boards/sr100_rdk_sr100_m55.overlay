/*
 * Keep the Ethos-U activations in system RAM and reserve a non-cached
 * buffer pool for live MIPI capture.
 *
 * The board's default code partition is ITCM, which is too small for this
 * sample once TFLM, host API and live MIPI support are enabled. Move the
 * executable image to SRAM and keep runtime data in a separate SRAM window.
 */

#include <zephyr/dt-bindings/memory-attr/memory-attr-arm.h>

/ {
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		video_capture_mem: video-capture-memory@33fe7000 {
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0x33fe7000 0x188000>;
			zephyr,memory-region = "VIDEO_CAPTURE_MEM";
			zephyr,memory-attr = <DT_MEM_ARM_MPU_RAM_NOCACHE>;
		};

		jpeg_encoder_mem: jpeg-encoder-memory@b4900000 {
			compatible = "zephyr,memory-region", "mmio-sram";
			reg = <0xB4900000 0x9D800>;
			zephyr,memory-region = "JPEG_ENCODER_MEM";
			zephyr,memory-attr = <DT_MEM_ARM_MPU_RAM_NOCACHE>;
		};
	};

	enc0: jpeg-enc-video {
		compatible = "syna,enc-video";
		status = "okay";
		interrupt-parent = <&nvic>;
		interrupts = <102 0>, <103 0>, <109 0>;
		interrupt-names = "frame-done", "fmin1-stored", "status";
		mode = <1>;
		memory-region = <&jpeg_encoder_mem>;
		frame-raw-offset = <0x4000>;
		max-jpeg-size = <0x1af00>;
	};
};

&ethosu0 {
	/delete-property/ fast-memory-region;
};

&video_syna0 {
	memory-region = <&video_capture_mem>;
};

&sram0 {
	/*
	 * Put code/rodata here so the application no longer depends on the
	 * 128 KB ITCM code partition. The current image uses about 149 KB of
	 * ROM, so 192 KB leaves margin while preserving the rest of SRAM for
	 * data sections.
	 */
	reg = <0x33ea0000 0x00030000>;
	ranges = <0x0 0x33ea0000 0x00030000>;
};

/ {
	data_sram: memory@33ed0000 {
		compatible = "mmio-sram";
		reg = <0x33ed0000 0x00117000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x33ed0000 0x00117000>;
	};

	chosen {
		zephyr,sram = &data_sram;
		zephyr,flash = &sram0;
		zephyr,code-partition = &sram0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Host API CDC";
	};

	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		label = "Stream CDC";
	};
};
