mainmenu "Bluetooth: BAP Unicast Client + Broadcast Source"

config INFO_REPORTING_INTERVAL
	int "SDUs received between each status report (0 = disabled)"
	default 1000

config BT_BAP_AUTO_CONNECT
	bool "Auto-connect without user interaction (unicast client mode)"
	default n

