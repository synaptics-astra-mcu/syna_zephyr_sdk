CONFIG_SERIAL=y
CONFIG_UART_NS16550=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_STDOUT_CONSOLE=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=192000000
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000
CONFIG_XIP=y
CONFIG_FLASH=y
# CONFIG_FLASH_BASE_ADDRESS=0x38000000
# CONFIG_FLASH_SIZE=32768
# CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_CORTEX_M_SYSTICK=y
CONFIG_ARM_MPU=y
CONFIG_DYNAMIC_INTERRUPTS=y
CONFIG_GEN_ISR_TABLES=y
CONFIG_CLOCK_CONTROL=y
CONFIG_SOC_EARLY_INIT_HOOK=y
CONFIG_RESET=y
CONFIG_ARM_SAU=y
CONFIG_ARM_MPC_SIE300=y
CONFIG_ARM_PPC=y
CONFIG_ENTROPY_GENERATOR=y
CONFIG_HEAP_MEM_POOL_SIZE=8192

# Enable Cortex-M52 cache
CONFIG_CACHE_MANAGEMENT=y
CONFIG_ARCH_CACHE=y

# Enable otf-cache
CONFIG_CACHE_ARM_AHB=y

CONFIG_COMPILER_OPT="-mbranch-protection=standard"
