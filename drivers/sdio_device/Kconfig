menu "SDIO device function drivers"

config SDIO_DEVICE
	bool
	help
	  Enable SDIO device/function controller driver support.

config SYNA_SDIO_DEVICE
	bool "Synaptics SDIO device function driver"
	default y
	depends on DT_HAS_SYNA_SDIO_DEVICE_ENABLED
	select RESET
	select SDIO_DEVICE
	help
	  Enable the Synaptics SDIO device peripheral function 2 DMA driver.

endmenu
