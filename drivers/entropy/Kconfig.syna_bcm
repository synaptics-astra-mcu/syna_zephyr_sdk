config ENTROPY_SYNA_BCM
	bool "Synaptics BCM TRNG driver"
	default y
	depends on DT_HAS_SYNA_BCM_TRNG_ENABLED
	select ENTROPY_HAS_DRIVER
	help
	  This option enables the true random number generator
	  driver based on the Synaptics BCM-TRNG.
